{
  "name": "XPixelMobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "build:android": "cd ../../XPixelNative/android && ./gradlew assembleRelease",
    "build:android:bundle": "cd ../../XPixelNative/android && ./gradlew bundleRelease",
    "publish:apk": "node ../../scripts/copy-apk.js ../../XPixelNative/android/app/build/outputs/apk/release/app-release.apk ../../apps/web/public/downloads/xpixel-android.apk"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.74.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "react-native-screens": "^3.31.1",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-document-picker": "^9.1.1",
    "react-native-fs": "^2.20.0",
    "react-native-share": "^10.1.2",
    "react-native-vision-camera": "^4.3.2",
    "react-native-reanimated": "^3.12.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-svg": "^15.3.0",
    "react-native-haptic-feedback": "^2.2.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-fast-image": "^8.6.3",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/blur": "^4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.74.83",
    "@react-native/eslint-config": "0.74.83",
    "@react-native/metro-config": "0.74.83",
    "@react-native/typescript-config": "0.74.83",
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.73.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "typescript": "5.0.4"
  },
  "jest": {
    "preset": "react-native"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
